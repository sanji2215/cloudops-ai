# AI Provider API Keys (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
XAI_DEFAULT_MODEL=grok-4.5
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
PERPLEXITY_API_KEY=

# OpenAI-compatible custom provider (optional)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Default AI routing
CLOUDOPS_DEFAULT_PROVIDER=groq
CLOUDOPS_DEFAULT_MODEL=openai/gpt-oss-20b
CLOUDOPS_FALLBACK_PROVIDER=
CLOUDOPS_FALLBACK_ENABLED=true

# Security
CLOUDOPS_SECURITY_MODE=standard
CLOUDOPS_CONFIRM_DESTRUCTIVE=true
CLOUDOPS_CONFIRM_WRITE=false

# Logging
CLOUDOPS_LOG_LEVEL=info

# Cloud credentials (used by CLI tools on the host, never stored by CloudOps)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDFLARE_API_TOKEN=
# VERCEL_TOKEN=
# GITHUB_TOKEN=
